# Copy to .env.local and fill in real values. Never commit .env.local.
# Every line must be KEY=value.

# --- AI (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-api-key
# Optional. Defaults to anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL=anthropic/claude-opus-5.5

# --- Stripe (sandbox / test mode) --------------------------------------------
STRIPE_SECRET_KEY=sk_test_api-key
# Signing secret of the webhook endpoint that points at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=webhook-secret
STRIPE_CURRENCY=eur
# Not used by the app, because Checkout is hosted by Stripe. Kept for reference.
STRIPE_PUBLISHABLE_KEY=publishable-key

# --- Demo logins --------------------------------------------------------------
# One invented password shared by owner@voltbox.demo, support@voltbox.demo and
# packer@voltbox.demo. Changing it and redeploying updates all three accounts.
DEMO_PASSWORD=choose-a-password

# --- Database ------------------------------------------------------------------
# Leave unset locally: `pnpm dev` starts an embedded Postgres by itself.
# On Vercel the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED.
# DATABASE_URL=postgres://user:password@host/database?sslmode=require

# --- Optional -------------------------------------------------------------------
# Public base URL, when it cannot be derived from the request.
# APP_URL=https://your-app.vercel.app
# Set to false to hide the demo controls (dispute hold, courier simulator, seed and reset).
# DEMO_MODE=true
